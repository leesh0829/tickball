# Vercel production/preview: managed PostgreSQL connection string (Neon recommended)
DATABASE_URL=

# Most managed PostgreSQL providers require TLS. Set false only for a trusted local DB.
DATABASE_SSL=true
DATABASE_POOL_SIZE=5

# Used only when DATABASE_URL is empty. PGlite persists local development data here.
TICKBALL_DB_PATH=./data/tickball.pglite

# Production enables Secure session cookies. The deployed service must use HTTPS.
NODE_ENV=development
